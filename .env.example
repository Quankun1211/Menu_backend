NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated production origins for user web and admin web.
FRONTEND_URLS=https://user.example.com,https://admin.example.com
# Production cross-domain frontend/backend: none (requires HTTPS).
# When both apps use a same-origin /api proxy, lax is also valid.
COOKIE_SAME_SITE=lax
# Leave empty unless frontend and backend share a parent domain you control.
COOKIE_DOMAIN=

# Atlas:
MONGO_DB_URL=mongodb+srv://USERNAME:PASSWORD@HOST/MenuApp?appName=Menu
# Local Docker alternative:
# MONGO_DB_URL=mongodb://menu_user:menu_password@localhost:27017/MenuApp?authSource=admin

REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_SHIPPING_FEE=25000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
WEB_URL=http://localhost:5173

GROQ_API_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/checkout/vnpay-return
